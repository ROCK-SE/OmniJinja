{
  "name": "omnijinja",
  "displayName": "OmniJinja",
  "description": "An Omni VSCode Extension for the Jinja Template Engine",
  "version": "0.0.8",
  "publisher": "rock-se",
  "icon": "image/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/ROCK-SE/OmniJinja.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python",
    "onLanguage:html",
    "onLanguage:jinja"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "OmniJinja",
      "properties": {
        "omnijinja.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Customize the Python interpreter path (e.g., 'python3' or '/usr/bin/python3'). Leave it blank to attempt automatic detection."
        }
      }
    },
    "languages": [
      {
        "id": "jinja",
        "aliases": [
          "Jinja",
          "jinja",
          "Jinja2"
        ],
        "extensions": [
          ".jinja",
          ".jinja2",
          ".j2"
        ]
      }
    ],
    "grammars": [
      {
        "language": "jinja",
        "scopeName": "text.html.jinja",
        "path": "./syntaxes/jinja.tmLanguage.json",
        "injectTo": [
          "text.html.basic",
          "text.html.derivative"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
